VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# If the client network cannot reach *.supabase.co, deploy the included
# Cloudflare proxy. workers.dev deployments select /supabase automatically.
# Set this path explicitly when the Worker uses a custom domain.
VITE_SUPABASE_PROXY_PATH=

# Set to true only after applying the Supabase migration and creating users.
VITE_CLOUD_MODE=false
