{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "miit-rover-delivery",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_ORIGIN": "https://nkvmpjznvkqmgcposaup.supabase.co"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/supabase/*"]
  }
}
